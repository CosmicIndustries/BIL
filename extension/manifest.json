{
  "manifest_version": 2,
  "name": "BIL Helper",
  "version": "0.1.0",
  "description": "Select text on any page and run it through the local BIL interpreter (server.py).",
  "permissions": ["storage", "http://127.0.0.1/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["shared/bil-panel.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "BIL Helper settings"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "bil-helper@cosmicindustries"
    }
  }
}
